<brls:Box
        axis="row"
        backgroundColor="#00000096"
        padding="16"
        cornerRadius="4"
        width="960"
        height="620">

    <brls:Box axis="column" width="440">
    <!--    File-->
    <brls:Label
            textColor="#FFFFFF"
            margin="3"
            fontSize="22"
            text="File"/>
    <brls:Box
            axis="row"
            height="50"
            marginBottom="3"
            marginLeft="0">
        <brls:Label
                textColor="#FFFFFF"
                fontSize="20"
                shrink="0"
                marginRight="4"
                text="Url:"/>
        <brls:Label
                id="profile/file/url"
                textColor="@theme/font/grey"
                fontSize="20"/>
    </brls:Box>
    <brls:Box
            axis="row"
            height="50"
            marginBottom="3"
            marginLeft="0">
        <brls:Label
                textColor="#FFFFFF"
                fontSize="20"
                shrink="0"
                marginRight="4"
                text="Size:"/>
