# Generate local renderer sources without changing dependency gitlinks.
set(NANOVG_SOURCE ${BOREALIS_LIBRARY}/lib/extern/nanovg/nanovg.c)
file(READ ${NANOVG_SOURCE} NANOVG_BIDI_SOURCE)
set(TEXT_RUNTIME_DIR ${CMAKE_CURRENT_BINARY_DIR}/text-runtime)
file(MAKE_DIRECTORY ${TEXT_RUNTIME_DIR})
file(READ ${BOREALIS_LIBRARY}/include/borealis/extern/nanovg/fontstash.h FONTSTASH_SOURCE)
set(RASTER_CALL "fons__tt_renderGlyphBitmap(&renderFont->font, dst, gw-pad*2,gh-pad*2, stash->params.width, scale, scale, g);")
string(FIND "${FONTSTASH_SOURCE}" "${RASTER_CALL}" RASTER_POSITION)
if(RASTER_POSITION EQUAL -1)
    message(FATAL_ERROR "FontStash rasterizer changed; review the fractional font weight hook")
endif()
string(REPLACE "${RASTER_CALL}" "${RASTER_CALL}\n\ttsvitchEmbolden(&stash->texData[glyph->x0 + glyph->y0 * stash->params.width], gw, gh, stash->params.width, codepoint);" FONTSTASH_SOURCE "${FONTSTASH_SOURCE}")
file(WRITE ${TEXT_RUNTIME_DIR}/fontstash.h "#include \"font_weight.h\"\n${FONTSTASH_SOURCE}")
configure_file(${CMAKE_CURRENT_SOURCE_DIR}/cmake/font_weight.h ${TEXT_RUNTIME_DIR}/font_weight.h COPYONLY)
if (PLATFORM_SWITCH)
    pkg_check_modules(FRIBIDI REQUIRED fribidi)
    string(REPLACE "float nvgText(" "static float tsvitchTextLtr(" NANOVG_BIDI_SOURCE "${NANOVG_BIDI_SOURCE}")
    string(REPLACE "float nvgTextWithCursor(" "static float tsvitchTextWithCursorLtr(" NANOVG_BIDI_SOURCE "${NANOVG_BIDI_SOURCE}")
    file(READ ${CMAKE_CURRENT_SOURCE_DIR}/cmake/nanovg_bidi.c BIDI_WRAPPERS)
    string(APPEND NANOVG_BIDI_SOURCE "\n${BIDI_WRAPPERS}")
    target_include_directories(borealis PRIVATE ${FRIBIDI_INCLUDE_DIRS})
    target_link_libraries(borealis ${FRIBIDI_STATIC_LIBRARIES})
endif()
file(WRITE ${TEXT_RUNTIME_DIR}/nanovg.c "${NANOVG_BIDI_SOURCE}")
get_target_property(BOREALIS_SOURCES borealis SOURCES)
list(REMOVE_ITEM BOREALIS_SOURCES ${NANOVG_SOURCE})
set_property(TARGET borealis PROPERTY SOURCES ${BOREALIS_SOURCES} ${TEXT_RUNTIME_DIR}/nanovg.c)
target_include_directories(borealis BEFORE PRIVATE ${TEXT_RUNTIME_DIR} ${BOREALIS_LIBRARY}/lib/extern/nanovg)
